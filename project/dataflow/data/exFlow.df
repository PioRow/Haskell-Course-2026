// Simple image-processing pipeline


transform resize from camera {
  width:  640,
  height: 480,
  tagged: true
}

transform grayscale from resize{
}

transform sepia from grayscale{}


sink display2 from sepia {
  name: "Processed Image2",

}


sink display from grayscale {
  name: "Processed Image",

}

source camera {
  width:  1280,
  height: 720,
  format: "rgb24",
  color:[2,1,37],
  isReal:true
}